  keys = COMMON_KEYS,<&key_physical_attrs 100 100 75 400 0 0 0>,<&key_physical_attrs 100 100 175 400 0 0 0>,<&key_physical_attrs 100 100 275 400 0 0 0>,<&key_physical_attrs 625 100 375 400 0 0 0>,<&key_physical_attrs 125 100 1000 400 0 0 0>,<&key_physical_attrs 100 100 1125 400 0 0 0>,<&key_physical_attrs 100 100 1225 400 0 0 0>,<&key_physical_attrs 100 100 1325 400 0 0 0>;
