  compatible = "zmk,physical-layout"; display-name = "3x1u - 2.75/2.25 split"; kscan = <&kscan0>;
  keys = COMMON_KEYS,<&key_physical_attrs 100 100 75 400 0 0 0>,<&key_physical_attrs 100 100 175 400 0 0 0>,<&key_physical_attrs 100 100 275 400 0 0 0>,<&key_physical_attrs 275 100 375 400 0 0 0>,<&key_physical_attrs 125 100 650 400 0 0 0>,<&key_physical_attrs 225 100 775 400 0 0 0>,<&key_physical_attrs 125 100 1000 400 0 0 0>,<&key_physical_attrs 100 100 1125 400 0 0 0>,<&key_physical_attrs 100 100 1225 400 0 0 0>,<&key_physical_attrs 100 100 1325 400 0 0 0>;
