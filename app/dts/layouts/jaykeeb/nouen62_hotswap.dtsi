  keys = COMMON_KEYS,<&key_physical_attrs 125 100 75 400 0 0 0>,<&key_physical_attrs 125 100 200 400 0 0 0>,<&key_physical_attrs 700 100 325 400 0 0 0>,<&key_physical_attrs 100 100 1025 400 0 0 0>,<&key_physical_attrs 100 100 1125 400 0 0 0>,<&key_physical_attrs 100 100 1225 400 0 0 0>,<&key_physical_attrs 100 100 1325 400 0 0 0>;
 };

 position_map {
  compatible = "zmk,physical-layout-position-map";
  all { physical-layout = <&all_layout>; positions = <COMMON_POS>; };
  split22527515 { physical-layout = <&split_225_275_15u_layout>; positions = <COMMON_POS>; };
  split2252751 { physical-layout = <&split_225_275_1u_layout>; positions = <COMMON_POS>; };
  split27522515 { physical-layout = <&split_275_225_15u_layout>; positions = <COMMON_POS>; };
  split2752251 { physical-layout = <&split_275_225_1u_layout>; positions = <COMMON_POS>; };
  space62515 { physical-layout = <&space625_15u_layout>; positions = <COMMON_POS>; };
  space6251 { physical-layout = <&space625_1u_layout>; positions = <COMMON_POS>; };
  space7 { physical-layout = <&space7u_layout>; positions = <COMMON_POS>; };
 };
};

#undef COMMON_POS
#undef COMMON_KEYS
